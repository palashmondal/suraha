# ==========================================================================
#  Suraha — every third-party credential, in one file.
# ==========================================================================
# Read by BOTH apps:
#   • api/  — loaded first in api/bootstrap/app.php, before api/.env
#   • web/  — Vite's envDir points here, so VITE_* vars are picked up
#
# api/.env and web/.env.local keep only framework plumbing (APP_KEY, DB_*,
# ports). Anything with an account behind it belongs here.
#
# Gitignored. Copy .env.example to start, and never commit this file.
# --------------------------------------------------------------------------

# ---- Web app ------------------------------------------------------------
# Same-origin API in dev; Vite proxies /api → :8000.
VITE_API_BASE=/api

# ---- Google Maps --------------------------------------------------------
# The ঘটনাস্থল map. Unset → falls back to Leaflet/OpenStreetMap, which needs
# no key. COMPILED INTO THE BROWSER BUNDLE, so it is public — restrict it:
#   Application restrictions → HTTP referrers → https://*.suraha.net/*
#   API restrictions        → Maps Embed API only
VITE_GOOGLE_MAPS_KEY=

# ---- SMS (Alpha SMS / sms.net.bd) ---------------------------------------
# `log` writes to storage/logs and sends nothing; `alpha` sends for real and
# costs money (~৳0.35/SMS; Bangla is Unicode, so 70 chars per part).
SMS_GATEWAY=alpha
SMS_ALPHA_API_KEY=
# Masked sender (SURAHA) needs provider approval; blank = shared number.
SMS_ALPHA_SENDER_ID=

# ---- BDRIS (জন্ম নিবন্ধন) -------------------------------------------------
# `mock` until the government grants access.
BDRIS_DRIVER=mock
