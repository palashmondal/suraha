# Copy to .env.local for local development.
#
# Production defaults (baked in if unset): central = https://suraha.com.bd,
# per-upazila = https://{slug}.suraha.com.bd. Override for local dev below.
#
# Point at the local Caddy HTTPS hosts (from scripts/dev.sh):
VITE_CENTRAL_BASE=https://suraha.com.bd
VITE_UPAZILA_BASE_TEMPLATE=https://{slug}.suraha.com.bd
#
# Browser dev (npm run dev) is cross-origin to the API, so the Laravel CORS config must allow this
# dev origin. On an actual Android device (Capacitor) there is no CORS and no override is needed.
