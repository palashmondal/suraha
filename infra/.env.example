# Suraha production env — copy to infra/.env and fill in. NEVER commit infra/.env.
#
# In the container api/.env does not exist (it is .dockerignore'd), so Laravel reads these
# real environment variables instead. Everything the app needs must be here.

APP_NAME=সুরাহা
APP_ENV=production
APP_DEBUG=false
# Generate once:  docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://suraha.net
ASSET_URL=https://suraha.net
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Postgres — host is the compose service name.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=suraha
DB_USERNAME=suraha
DB_PASSWORD=change-me
DB_PERSISTENT=true

# No Redis in the stack: nothing queues or schedules, so the database drivers are enough.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Uploads live on the local public disk, persisted by the `uploads` volume.
FILESYSTEM_DISK=local

# ---- Integrations -------------------------------------------------------
# BDRIS (জন্ম নিবন্ধন) — `mock` until the government grants access.
BDRIS_DRIVER=mock
BDRIS_BASE_URL=
BDRIS_API_KEY=

# SMS (Alpha SMS / sms.net.bd) — `log` sends nothing; `alpha` sends for real and costs money.
SMS_GATEWAY=log
SMS_ALPHA_API_KEY=
SMS_ALPHA_SENDER_ID=

# Baked into the browser bundle at build time, so it is public — restrict it in the Google
# console to HTTP referrer https://*.suraha.net/*. Blank → Leaflet/OpenStreetMap fallback.
VITE_GOOGLE_MAPS_KEY=
