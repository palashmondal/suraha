# Suraha infra secrets (copy to infra/.env). Per-tenant integration credentials
# (BDRIS, SMS, S3) are configuration — see SURAHA_BUILD_PROMPT §12.2.
APP_ENV=production
APP_URL=https://suraha.com.bd

DB_DATABASE=suraha
DB_USERNAME=suraha
DB_PASSWORD=change-me

REDIS_HOST=redis

# S3-compatible object storage
S3_KEY=suraha
S3_SECRET=change-me-too
S3_BUCKET=suraha
S3_ENDPOINT=http://minio:9000

# Integrations (behind swappable adapters)
BDRIS_DRIVER=mock          # mock | live  — real API when SEAL access is granted (§1.1(1))
BDRIS_BASE_URL=
BDRIS_API_KEY=
SMS_DRIVER=log             # log | <provider> — OTP only (§1.1(3-4))
SMS_API_KEY=
